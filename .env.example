# Supabase project settings — Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to build OAuth/email redirect URLs. Update to the production URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RAWG.io API key — https://rawg.io/apidocs. Server-side only, never expose to the browser.
RAWG_API_KEY=
